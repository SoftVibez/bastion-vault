# Copy this file to .env and fill in your own values. Never commit .env.
#
# The deployer/owner key should be a FRESH burner key generated only for this
# project — never reuse a key from another wallet.

# RPC endpoint for Base mainnet (e.g. from Alchemy, Infura, or a public RPC).
BASE_RPC_URL=https://mainnet.base.org

# RPC endpoint for Base Sepolia testnet — use this for the dry run.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Private key of the burner deployment wallet (this becomes the vault's
# immutable owner). Format: 0x-prefixed hex, no quotes.
PRIVATE_KEY=

# Basescan API key, for `forge verify-contract` / --verify on deploy.
BASESCAN_API_KEY=
