# Copy this file to .env and fill in your own values. Never commit .env.
#
# The deployer/owner key should be a FRESH burner key generated only for this
# project — never reuse a key from another wallet.

# RPC endpoint for Polygon mainnet (e.g. from Alchemy, Infura, or a public RPC).
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Private key of the burner deployment wallet (this becomes the vault's
# immutable owner). Format: 0x-prefixed hex, no quotes.
PRIVATE_KEY=

# Polygonscan API key, for `forge verify-contract` / --verify on deploy.
POLYGONSCAN_API_KEY=
